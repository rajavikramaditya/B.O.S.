# Install on VM (owner-approved). Tight allowlist for self-heal host agent.
# Example:
#   sudo cp deploy/gcp-vm/neena-self-heal.sudoers /etc/sudoers.d/neena-self-heal
#   sudo chmod 440 /etc/sudoers.d/neena-self-heal
#
# Adjust user if the timer runs as a non-root user. Prefer running the
# oneshot service as root via systemd (no sudo needed for reboot/systemctl).

# If ExecStart runs as root via systemd, this file is unused.
# Kept as documentation for any future unprivileged agent user.
