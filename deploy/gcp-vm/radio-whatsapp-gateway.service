[Unit]
Description=Orai Radio WhatsApp Gateway Node Service
After=network.target radio-command-center.service

[Service]
User=mahilkingdomorai
WorkingDirectory=/home/mahilkingdomorai/radio-ai-manager/whatsapp
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

[Install]
WantedBy=multi-user.target
