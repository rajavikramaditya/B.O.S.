# =====================================================================
# B.O.S. — Business Operating System
# Copy to .env and fill in what you need. NEVER commit .env.
# Every value is optional: B.O.S. starts with safe defaults, and AI keys
# and channels can be connected from the dashboard instead.
# =====================================================================

# development | production
ENVIRONMENT=production

# Public https address of this server. Needed so Telegram/WhatsApp can
# deliver customer messages to B.O.S. (e.g. https://bos.yourbusiness.com)
PUBLIC_BASE_URL=

# --- AI model (or paste a key in Integrations → Claude / Gemini) ---------
# auto = use whichever is configured (Claude first). Or: anthropic | gemini
BOS_AI_PROVIDER=auto
ANTHROPIC_API_KEY=
BOS_CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
BOS_GEMINI_MODEL=gemini-2.5-flash

# --- Autopilot -------------------------------------------------------------
# How often B.O.S. reviews the business on its own (minutes, minimum 5)
BOS_AUTOPILOT_INTERVAL_MINUTES=60
BOS_AUTOPILOT_SCHEDULER=true

# --- Storage (defaults to SQLite files in BOS_DATA_DIR) --------------------
# BOS_DATA_DIR=/data
# DATABASE_URL=postgresql+psycopg://bos:bos@postgres:5432/bos
# MEMORY_DATABASE_URL=postgresql+psycopg://bos:bos@postgres:5432/bos_memory

# --- Security --------------------------------------------------------------
# Signs sessions and encrypts stored credentials. Generated automatically
# into BOS_DATA_DIR if empty — set it explicitly to manage it yourself.
# Changing it signs everyone out and makes saved credentials unreadable.
BOS_SECRET_KEY=

# Only needed if the dashboard is served from a different origin.
# BOS_CORS_ORIGINS=https://app.example.com

# Host port for docker compose
BOS_PORT=8000
