# ====================================================================
# Orai Radio Command Center Configuration (GCP Compute VM Setup)
# Copy to .env and fill real values. NEVER commit .env.
# ====================================================================

# Runtime Environment Mode
RUNTIME_MODE=gcp-vm

# Base public address for web access / gateways
PUBLIC_BASE_URL=http://YOUR_PUBLIC_IP_OR_DOMAIN

# API public connection endpoint base for mobile app
APP_API_BASE_URL=http://YOUR_PUBLIC_IP_OR_DOMAIN:8000

# Public icecast stream mount point URL for app playback
STREAM_PUBLIC_URL=https://stream.orairadio.in/listen/orai_radio/radio.mp3

# AzuraCast UI/API (NOT admin.orairadio.in — that host is Neena Command Center)
AZURACAST_BASE_URL=https://azura.orairadio.in
AZURACAST_STATION_ID=1
AZURACAST_PUBLIC_PAGE=http://YOUR_PUBLIC_IP_OR_DOMAIN/public/orai_radio
AZURACAST_STREAM_URL=http://YOUR_PUBLIC_IP_OR_DOMAIN/listen/orai_radio/radio.mp3
# Real upload/playlist/queue APIs — keep false until write-config verified on VM.
# Owner confirm ("push karo") still required even when true.
AZURACAST_WRITES_ENABLED=false

# Node.js WhatsApp Gateway endpoints (local node listener on VM)
WHATSAPP_GATEWAY_URL=http://localhost:3001/api/status

# Owner/Operator Contacts for routing admin command triggers
OWNER_WHATSAPP_NUMBER=+91XXXXXXXXXX
OWNER_PHONE_NUMBER=+91XXXXXXXXXX

# Public customer WhatsApp brain — current station situation (honest answers)
# When app/ads go live, flip these to true on the VM .env and restart backend.
STATION_APP_PUBLIC_READY=false
STATION_ADS_LIVE=false
STATION_PUBLIC_LAUNCH_NOTE=Hum agle kuch dino me (lagbhag 4-5 din ke around) public live / full launch ki taraf badh rahe hain.
# Feature flags (defaults on in code when unset — flip false to disable)
# NEENA_SMART_REPLY=true
# NEENA_CONV_MEMORY=true
# NEENA_JOB_FOLLOWUP=true
# NEENA_JOB_WHATSAPP_PUSH=true
# NEENA_CUSTOMER_BRAIN=true
# NEENA_OWNER_CUSTOMER_CONTEXT=true
# NEENA_LISTENER_PATH_TOOLS=true
# NEENA_RECORDER_SELF_CHECK=true
# NEENA_HUMANIZE_LIVE_OPS=true
# NEENA_ONE_BRAIN_FOUNDATION=true
# NEENA_CUSTOMER_SALIENT_MEMORY=true
# NEENA_MEMORY_SOFT_FADE=true
# NEENA_OWNER_WORKING_CONTEXT=true
# NEENA_SYSTEM_KNOWLEDGE_PACK=true
# NEENA_BOUNDED_TOOL_LOOP=true
# NEENA_DEEP_AGENT_LOOP=false
# Phase 4–5 CC Settings can override working-context / system-pack / bounded /
# deep-loop flags at runtime (Redis); clearing the override restores env default.

# Gemini API Key for WhatsApp chat bot responses (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key for voice generation (RJ speech synthesis)
ELEVENLABS_API_KEY=

# Phone Calling Configuration (Disabled in this phase)
CALLING_ENABLED=false
CALL_PROVIDER=disabled
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Admin Panel Authorization
ADMIN_AUTH_ENABLED=true
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_API_KEY=
APP_CONFIG_ADMIN_TOKEN=

# M4-A8 — Owner phrase unlock (set real phrase only in VM .env, never commit)
ADMIN_UNLOCK_PHRASE=your_owner_unlock_phrase_here
ADMIN_UNLOCK_MIN_SCORE=0.70
ADMIN_UNLOCK_SESSION_DAYS=7
ADMIN_UNLOCK_REQUIRED_WORDS=word1,word2,word3

# M4-A7 Command Center security (local dev defaults to local-only)
COMMAND_CENTER_LOCAL_ONLY=true

# M2 shadow memory stack (docker-compose.memory.yml defaults)
# NEENA_PG_HOST=127.0.0.1
# NEENA_PG_PORT=5432
# NEENA_REDIS_HOST=127.0.0.1
# NEENA_REDIS_PORT=6379

# Production and Docker Readiness Configs
ALLOW_INSECURE_SSL_DEV_ONLY=false
ALLOW_SIMULATED_TTS_DEV_ONLY=false
ENVIRONMENT=development

# Docker internal service configuration defaults
# NEENA_PG_HOST=neena-postgres
# NEENA_REDIS_HOST=neena-redis
